{
  "manifest_version": 3,
  "name": "Rotho YTTV Multiview",
  "version": "0.4.0",
  "description": "Lets the Rotho YTTV Multiview Stream Deck plugin switch audio between YouTube TV tabs.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "storage", "alarms", "scripting"],
  "host_permissions": ["https://tv.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://tv.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
