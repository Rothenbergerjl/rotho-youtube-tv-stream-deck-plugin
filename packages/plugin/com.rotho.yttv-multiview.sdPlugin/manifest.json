{
  "Name": "Rotho YTTV Multiview",
  "Version": "0.2.0.0",
  "Author": "Rothenbergerjl",
  "Actions": [
    {
      "Name": "Game Slot",
      "UUID": "com.rotho.yttv-multiview.slot",
      "Icon": "imgs/actions/slot/icon",
      "Tooltip": "Shows a YouTube TV game; press to hear only that game.",
      "PropertyInspectorPath": "ui/slot.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/slot/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Mute All",
      "UUID": "com.rotho.yttv-multiview.muteall",
      "Icon": "imgs/actions/muteall/icon",
      "Tooltip": "Mutes every YouTube TV tab; press again to restore the last game.",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/muteall/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Open YouTube TV",
      "UUID": "com.rotho.yttv-multiview.open",
      "Icon": "imgs/actions/open/icon",
      "Tooltip": "Opens YouTube TV in a new Chrome window or tab; the new game starts muted.",
      "PropertyInspectorPath": "ui/open.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/open/key",
          "TitleAlignment": "middle",
          "ShowTitle": false
        }
      ]
    }
  ],
  "Category": "Rotho YTTV Multiview",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Show your open YouTube TV games on Stream Deck keys and switch which one you hear.",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "UUID": "com.rotho.yttv-multiview"
}
